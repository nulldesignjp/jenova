/*
  header,
  footer,
  navigation
*/


header.siteHeader

  padding 2em 0
  line-height 1

  h1
    margin 0
    font-size: 1.5em
    font-weight 500

  p
    margin-top 1em
    margin-bottom 0
    font-size small


footer.siteFooter

  p
    margin 0
    padding 0
    line-height 1
    text-align right
    font-size small


nav.siteNavigation

  ul
    display flex
    border-top 1px solid #CCC
    border-bottom 1px solid #CCC
    padding 0.5em 0
    font-size small

    li
      margin 0 10px 0 0
      padding 0
      list-style-type none

      a
        padding 0 0.5em
        line-height 1
        border-radius 0.1em

canvas.webglview
  position fixed
  left 0
  top 0
  width 100%
  height 100vh
  z-index -1